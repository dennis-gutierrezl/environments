{
	"name": ".NET 10 Development Environment",
	"remoteUser": "vscode",
	"workspaceFolder": "/app",
	"dockerComposeFile": [
		"../compose.yaml"
	],
	"service": "app",
	"runServices": [
		"mssql",
		"adminer",
		"postgres",
		"pgadmin",
		"redis",
		"redis-insight",
		"rabbitmq"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"oderwat.indent-rainbow",
				"redhat.vscode-yaml"
			]
		}
	}
}